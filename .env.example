# Modo de acceso:
#   local = entra directo desde tu propio ordenador (sin friccion)
#   login = exige usuario y contrasena (recomendado si compartes en red local)
GRUIA_AUTH_MODE=local

# Solo local por defecto para proteger tus datos
GRUIA_HOST=127.0.0.1
GRUIA_PORT=8787

# Nombre visible de tu empresa en la cabecera de la herramienta
GRUIA_COMPANY_NAME=Mi Empresa

# Clave para firmar sesiones en modo login (cambiala en despliegues compartidos)
GRUIA_SESSION_SECRET=cambia-esta-clave-local-antes-de-compartir

# Opcional: ocultar el aviso discreto de soporte 24h en la barra inferior (1 / 0)
GRUIA_SHOW_HELP_BANNER=1
